# ESP-IDF build defaults for the ESP32 air-quality monitor (ESP-IDF 5.5.x).
# Generated with `idf.py save-defconfig`, then grouped and commented by hand.
# A few values that equal the Kconfig defaults are spelled out on purpose so
# the full pin map is visible here (it must match main/pins.h).

# ---- Chip, flash, partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_SYSTEM_CHECK_INT_LEVEL_5=y
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y

# ---- LVGL ----
CONFIG_LV_COLOR_16_SWAP=y

# ---- Display: ST7789P3, 320x240 landscape, SPI2 (HSPI) ----
CONFIG_LV_TFT_DISPLAY_USER_CONTROLLER_ST7789=y
CONFIG_LV_DISPLAY_ORIENTATION_LANDSCAPE=y
CONFIG_LV_TFT_DISPLAY_SPI2_HOST=y
# IPS panel: colours are wrong without inversion
CONFIG_LV_INVERT_COLORS=y
CONFIG_LV_DISP_SPI_MOSI=13
CONFIG_LV_DISPLAY_USE_SPI_MISO=y
CONFIG_LV_DISP_SPI_MISO=12
CONFIG_LV_DISP_SPI_CLK=14
CONFIG_LV_DISP_SPI_CS=15
CONFIG_LV_DISP_PIN_DC=2
# Panel reset is tied to the ESP32 EN pin: no reset GPIO, the driver sends a software reset
CONFIG_LV_DISP_USE_RST=n
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=27

# ---- Touch: XPT2046 on the same SPI2 bus ----
CONFIG_LV_TOUCH_CONTROLLER_XPT2046=y
CONFIG_LV_TOUCH_CONTROLLER_SPI2_HOST=y
CONFIG_LV_TOUCH_SPI_MISO=12
CONFIG_LV_TOUCH_SPI_MOSI=13
CONFIG_LV_TOUCH_SPI_CLK=14
CONFIG_LV_TOUCH_SPI_CS=33
CONFIG_LV_TOUCH_PIN_IRQ=36
CONFIG_LV_TOUCH_DETECT_PRESSURE=y
# Calibration
CONFIG_LV_TOUCH_X_MIN=200
CONFIG_LV_TOUCH_Y_MIN=120
CONFIG_LV_TOUCH_X_MAX=1900
CONFIG_LV_TOUCH_Y_MAX=1900
CONFIG_LV_TOUCH_XY_SWAP=y
CONFIG_LV_TOUCH_INVERT_X=y
CONFIG_LV_TOUCH_INVERT_Y=y
